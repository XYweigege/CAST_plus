// 保险客户声音（VoC）智能分析系统 - 数据模型

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// 监控主题词：业务关注的问题主题，支持人工维护与 AI 自动扩展
model Topic {
  id            String     @id @default(uuid())
  text          String     @unique
  category      String? // 归属类别，如：理赔时效、销售误导
  isActive      Boolean    @default(true)
  hitCount      Int        @default(0) // 命中次数，驱动关键词调优闭环
  autoGenerated Boolean    @default(false) // 是否由 AI 扩展生成
  approved      Boolean    @default(true) // 人工确认状态
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  feedbacks     Feedback[]
}

/// 客户反馈：来自问卷、索赔、客服、社媒等渠道的原始文本
model Feedback {
  id          String    @id @default(uuid())
  title       String?
  content     String
  source      String // survey / claim / service / social / appstore / email
  sourceId    String?
  url         String?
  rating      Int? // 客户评分 1-5
  productLine String? // travel / medical / accident / home / motor / pet
  language    String? // zh-HK / en / mixed
  authorName  String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  // ===== AI 分析输出 =====
  sentiment     String   @default("neutral") // positive / neutral / negative
  topics        String? // JSON 数组，命中的主题标签
  urgency       String   @default("info") // info / attention / action / critical
  urgencyReason String? // 定级理由
  aiSummary     String? // 一句话归因
  confidence    Float? // 判定置信度，低于阈值转人工复核

  // ===== 人工复核（人机协同闭环）=====
  humanLabel    String?
  isReviewed    Boolean  @default(false)

  topicId String?
  topic   Topic?   @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@unique([source, sourceId])
  @@index([createdAt])
  @@index([urgency])
  @@index([sentiment])
}

/// 预警：负面反馈、主题突增等需要业务介入的信号
model Alert {
  id         String   @id @default(uuid())
  type       String // negative / surge / critical
  title      String
  content    String
  urgency    String   @default("info")
  isRead     Boolean  @default(false)
  handled    Boolean  @default(false) // 业务是否处置
  feedbackId String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model Setting {
  id    String @id @default(uuid())
  key   String @unique
  value String
}
